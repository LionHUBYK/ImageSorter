<Window x:Class="ImageSorter.SorterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorter" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="22">
        <TextBlock Text="Name" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" MaxLength="60"/>

        <TextBlock Text="Folder" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox" IsReadOnly="True"/>
        </DockPanel>

        <TextBlock Text="Hotkey" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="KeyButton" MinWidth="170" Click="KeyButton_Click"/>
            <Button Content="No hotkey" Margin="8,0,0,0" Click="ClearKey_Click"/>
        </StackPanel>
        <TextBlock x:Name="KeyNote" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92"/>
            <Button Content="Save" IsDefault="True" MinWidth="92" Margin="8,0,0,0"
                    Style="{DynamicResource AccentButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
