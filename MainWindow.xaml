<Window x:Class="ImageSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageSorter"
        Title="Image Sorter" Width="1280" Height="800" MinWidth="940" MinHeight="560"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        AllowDrop="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One half of the Move / Copy switch -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="5" Padding="16,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet icon button -->
        <Style x:Key="Subtle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filmstrip cell: 112 wide + 3px margin each side = 118 (MainWindow.FilmCell) -->
        <Style x:Key="FilmItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Cell" Width="112" Height="84" Margin="3,6" CornerRadius="6"
                                BorderThickness="2" BorderBrush="Transparent" Background="#121212">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FilmTemplate" DataType="{x:Type local:ImageItem}">
            <Grid ToolTip="{Binding RelativeName}" Background="Transparent">
                <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2"/>
                <!-- Marks the first picture of each subfolder with that folder's name -->
                <Border x:Name="FolderBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" MaxWidth="102"
                        Background="#E6101010" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="4" Padding="5,1,6,2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="9" Text="&#xE8B7;" Margin="0,1,4,0"/>
                        <TextBlock Text="{Binding FolderLabel}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                        Background="#C0000000" CornerRadius="4" Padding="5,3">
                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE768;"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FolderLabel}" Value="{x:Null}">
                    <Setter TargetName="FolderBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A sorter: hotkey, name, folder and the pictures sent there -->
        <DataTemplate x:Key="BinTemplate" DataType="{x:Type local:Sorter}">
            <Border x:Name="Card" Margin="12,0,12,10" Padding="12,10,8,10" CornerRadius="8" BorderThickness="1"
                    Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}" Cursor="Hand"
                    MouseLeftButtonUp="Bin_Click" ToolTip="Click, or press the key, to send the current picture here">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit name, folder or hotkey" Click="BinEdit_Click"/>
                        <MenuItem Header="Open folder in Explorer" Click="BinOpen_Click"/>
                        <Separator/>
                        <MenuItem Header="Move up" Click="BinUp_Click"/>
                        <MenuItem Header="Move down" Click="BinDown_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove from this list" Click="BinRemove_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" MinWidth="32" Height="30" Margin="0,0,10,0" Padding="8,0"
                                CornerRadius="6" Background="#101010" BorderBrush="#5C5C5C" BorderThickness="1,1,1,3">
                            <TextBlock Text="{Binding KeyLabel}" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Subtle}" Click="BinMenu_Click" ToolTip="More">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,4,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="0,5,4,0" Text="{Binding Folder}" FontSize="11"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Row="2" MinHeight="52" Margin="0,10,0,0">
                        <TextBlock x:Name="EmptyHint" Text="{Binding EmptyHint}" FontSize="12" Visibility="Collapsed"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <!-- Two rows of 52px pictures at most; older ones are clipped away -->
                        <ItemsControl x:Name="ThumbHost" ItemsSource="{Binding Recent}" MaxHeight="110"
                                      ClipToBounds="True" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BinThumb}">
                                    <Border Width="52" Height="52" Margin="0,0,6,6" CornerRadius="5" Background="#161616"
                                            ToolTip="{Binding Name}">
                                        <Border CornerRadius="5">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                    <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Focusable="False" Click="OpenFolder_Click" ToolTip="Open a folder (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0"/>
                        <TextBlock Text="Open folder"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="SubfoldersCheck" Content="Include subfolders" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="Subfolders_Click"/>
                    <ComboBox x:Name="OrderCombo" Width="140" Focusable="False" VerticalAlignment="Center"
                              Margin="0,0,14,0" SelectionChanged="Order_Changed" ToolTip="Order of the pictures">
                        <ComboBoxItem Content="By name"/>
                        <ComboBoxItem Content="Oldest first"/>
                        <ComboBoxItem Content="Newest first"/>
                    </ComboBox>
                    <Border CornerRadius="7" Padding="2" Margin="0,0,14,0" VerticalAlignment="Center"
                            Background="{StaticResource Bg0}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            ToolTip="What a hotkey does with the picture (Tab switches)">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MoveSegment" Style="{StaticResource Segment}" GroupName="Mode"
                                         Content="Move" Checked="Mode_Changed"/>
                            <RadioButton x:Name="CopySegment" Style="{StaticResource Segment}" GroupName="Mode"
                                         Content="Copy" Checked="Mode_Changed"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UndoButton" Focusable="False" IsEnabled="False" Click="Undo_Click" ToolTip="Undo the last sort (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,8,0"/>
                            <TextBlock Text="Undo"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="CounterText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,18,0"
                           Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Picture on the left, sorters on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="BinsColumn" Width="380" MinWidth="270" MaxWidth="720"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="ViewerHost" Grid.Row="0" Background="#0E0E0E" ClipToBounds="True"
                        MouseWheel="Viewer_MouseWheel" MouseLeftButtonDown="Viewer_MouseDown"
                        MouseMove="Viewer_MouseMove" MouseLeftButtonUp="Viewer_MouseUp">
                    <Grid>
                        <Grid x:Name="ZoomLayer">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ZoomScale"/>
                                    <TranslateTransform x:Name="ZoomPan"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="MainImage" Stretch="Uniform" Margin="14"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <MediaElement x:Name="Player" Margin="14" Stretch="Uniform" Visibility="Collapsed"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>

                        <Border x:Name="NamePill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                Background="#B8000000" CornerRadius="6" Padding="10,5" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="NameText" FontSize="12"/>
                        </Border>

                        <TextBlock x:Name="ProblemText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" Visibility="Collapsed" IsHitTestVisible="False"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Style="{StaticResource Icon}" FontSize="34" Text="&#xE8B9;" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,14,0,6" Text="Pick a folder to start"/>
                            <TextBlock x:Name="EmptyBody" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="Open a folder of pictures, add a few sorters on the right, then press their keys to file each one."/>
                            <Button Content="Open folder" HorizontalAlignment="Center" Margin="0,18,0,0" Focusable="False"
                                    Style="{DynamicResource AccentButtonStyle}" Click="OpenFolder_Click"/>
                        </StackPanel>

                        <Border x:Name="VideoBar" VerticalAlignment="Bottom" Margin="14" Padding="6,2" CornerRadius="8"
                                Background="#D0141414" Visibility="Collapsed" MouseLeftButtonDown="Swallow_MouseDown">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource Subtle}" Click="PlayPause_Click" ToolTip="Play or pause">
                                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" Text="&#xE769;"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Subtle}" Click="Mute_Click" ToolTip="Sound on or off">
                                    <TextBlock x:Name="MuteGlyph" Style="{StaticResource Icon}" Text="&#xE74F;"/>
                                </Button>
                                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,6,0"
                                           Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                <Slider x:Name="SeekSlider" VerticalAlignment="Center" Margin="6,0,0,0" Focusable="False"
                                        IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <ListBox x:Name="Filmstrip" Grid.Row="1" Height="118" Padding="0"
                         Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                         ItemContainerStyle="{StaticResource FilmItem}" ItemTemplate="{StaticResource FilmTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="Filmstrip_SelectionChanged" PreviewMouseWheel="Filmstrip_MouseWheel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{StaticResource Stroke}" Focusable="False"/>

            <Grid Grid.Column="2" Background="{StaticResource Bg1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="14,12,12,12">
                    <Button DockPanel.Dock="Right" Focusable="False" Click="AddSorter_Click" ToolTip="Pick a folder to sort into">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0"/>
                            <TextBlock Text="Add sorter"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Sorters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="BinsList" ItemTemplate="{StaticResource BinTemplate}" Focusable="False"/>
                </ScrollViewer>

                <TextBlock x:Name="BinsEmpty" Grid.Row="1" Margin="28,24" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Top" Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                           Text="Add a folder to sort into. Each one gets a number key, which you can change to any key you like."/>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextMuted}"
                           Text="← →  browse     Space  skip     Ctrl+Z  undo     Tab  move or copy     Scroll  zoom"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
            </DockPanel>
        </Border>

        <!-- Pictures fly across this layer on their way to a sorter -->
        <Canvas x:Name="Overlay" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
</Window>
