<Application x:Class="ImageSorter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg0" Color="#161616"/>
        <SolidColorBrush x:Key="Bg1" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Bg2" Color="#272727"/>
        <SolidColorBrush x:Key="Bg3" Color="#343434"/>
        <SolidColorBrush x:Key="Stroke" Color="#383838"/>
        <SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A6A6A6"/>
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="OnAccent" Color="#00263A"/>
        <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
